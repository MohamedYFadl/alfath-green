# =============================================================================
# Al Fath Green — Apache config for static hosting (Hostinger shared hosting)
# =============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Canonical host: force HTTPS -------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- Root goes to the default locale ---------------------------------------
  # A real 301 rather than the meta-refresh page Astro emits as a fallback.
  RewriteRule ^$ /ar/ [R=301,L]

  # --- Serve the prerendered directory-style pages ---------------------------
  # /ar/products  ->  /ar/products/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

# --- Custom 404 --------------------------------------------------------------
# Answer in the language of the URL that was requested. <If> is Apache 2.4 core
# and needs the same AllowOverride FileInfo that ErrorDocument already requires.
# If a host ignores these blocks, the default below still serves, and the small
# script in 404.html forwards to the matching locale.
ErrorDocument 404 /404.html

<If "%{REQUEST_URI} =~ m#^/ar/#">
  ErrorDocument 404 /ar/404/index.html
</If>
<ElseIf "%{REQUEST_URI} =~ m#^/en/#">
  ErrorDocument 404 /en/404/index.html
</ElseIf>
<ElseIf "%{REQUEST_URI} =~ m#^/fr/#">
  ErrorDocument 404 /fr/404/index.html
</ElseIf>

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# --- Caching -----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Content-hashed build output can be cached hard.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|mp4)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>

  # HTML must revalidate so content updates go live immediately.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Security headers --------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
