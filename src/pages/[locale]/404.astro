---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotFound from '../../components/NotFound.astro';
import { locales, useTranslations, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

/**
 * Per-locale error page. `public/.htaccess` points ErrorDocument at the one
 * matching the requested URL prefix, so a missing page under /en/ answers in
 * English with the right `lang`/`dir` and a working language switcher.
 */
const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title={`${t.seo.notFound.title} | ${t.site.name}`}
  description={t.seo.notFound.description}
  noindex
>
  <NotFound locale={locale} />
</BaseLayout>
