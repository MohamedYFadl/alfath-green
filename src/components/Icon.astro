/**
 * Hand-drawn line icon set — deliberately small and hand-written rather than
 * a full icon library, so every glyph matches the brand's stroke weight.
 */
interface Props {
  name: keyof typeof paths;
  size?: number;
  stroke?: number;
  class?: string;
  filled?: boolean;
  /**
   * Catch-all so the parent's scoped-style marker (`data-astro-cid-*`, which
   * Astro passes down as a prop) can be forwarded onto the <svg>. Without it
   * a parent's scoped selector targeting an icon silently never matches.
   */
  [key: string]: unknown;
}

