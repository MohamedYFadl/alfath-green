---
import Icon from './Icon.astro';
import { localizePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  eyebrow?: string;
  title: string;
  sub?: string;
  /** Trail of ancestor links; the current page is appended automatically. */
  breadcrumb?: { label: string; href: string }[];
}

const { locale, eyebrow, title, sub, breadcrumb = [] } = Astro.props;
const t = useTranslations(locale);
---

<section class="page-header">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol role="list">
        <li>
          <a href={localizePath('/', locale)}>{t.nav.home}</a>
        </li>
        {
          breadcrumb.map((crumb) => (
            <li>
              <Icon name="chevron-down" size={13} class="crumbs__sep" />
              <a href={crumb.href}>{crumb.label}</a>
            </li>
          ))
        }
        <li>
          <Icon name="chevron-down" size={13} class="crumbs__sep" />
          <span aria-current="page">{title}</span>
        </li>
      </ol>
    </nav>

    <div class="page-header__text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {sub && <p class="section-sub">{sub}</p>}
    </div>
  </div>
</section>

<style>
  .page-header {
    position: relative;
    padding-block: clamp(2rem, 1.4rem + 2.4vw, 3.25rem) clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
    background:
      radial-gradient(120% 140% at 100% 0%, rgba(124, 179, 66, 0.12), transparent 60%),
      var(--warm-white);
    border-block-end: 1px solid var(--border-light);
  }

  /* ---------------------------- breadcrumb ---------------------------- */

  .crumbs ol {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    font-size: 0.8125rem;
  }

  .crumbs li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--stone-gray);
  }

  .crumbs a {
    color: var(--stone-gray);
    transition: color 0.2s var(--ease);
  }

  .crumbs a:hover {
    color: var(--forest-green);
  }

  .crumbs [aria-current='page'] {
    color: var(--soil-dark);
    font-weight: 600;
  }

  /* The chevron glyph points down; rotate it into a direction-aware caret. */
  .crumbs :global(.crumbs__sep) {
    rotate: 90deg;
    opacity: 0.5;
    flex-shrink: 0;
  }

  :global([dir='rtl']) .crumbs :global(.crumbs__sep) {
    rotate: -90deg;
  }

  .page-header__text {
    margin-block-start: 1.25rem;
    max-inline-size: 70ch;
  }

  .page-header__text .section-sub {
    max-inline-size: 62ch;
  }
</style>
