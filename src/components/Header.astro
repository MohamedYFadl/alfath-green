---
import { Image } from 'astro:assets';
import LangSwitcher from './LangSwitcher.astro';
import Icon from './Icon.astro';
import logoMark from '../assets/images/brand/logo-mark.png';
import { mainNav } from '../config/site';
import { localizePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localizePath('/', locale);
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="brand" href={home}>
      <Image src={logoMark} alt="" width={48} height={48} class="brand__mark" loading="eager" />
      <span class="brand__text">
        <strong>{t.site.name}</strong>
        <span>{locale === 'ar' ? t.site.nameLatin : t.site.tagline}</span>
      </span>
      <span class="sr-only">{t.site.name} — {t.nav.home}</span>
    </a>

    <nav class="main-nav" aria-label={t.nav.menu}>
      <ul role="list">
        {
          mainNav.map((item) => (
            <li>
              <a href={localizePath(item.path, locale)}>{t.nav[item.key]}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LangSwitcher locale={locale} class="header-lang" />
      <a class="btn btn--primary btn--sm header-cta" href={localizePath('/contact', locale)}>
        {t.actions.requestCatalog}
      </a>
      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t.nav.openMenu}
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
      >
        <Icon name="menu" size={22} class="nav-toggle__open" />
        <Icon name="close" size={22} class="nav-toggle__close" />
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav aria-label={t.nav.menu}>
      <ul role="list">
        {
          mainNav.map((item) => (
            <li>
              <a href={localizePath(item.path, locale)}>{t.nav[item.key]}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn--primary" href={localizePath('/contact', locale)}>
      {t.actions.requestCatalog}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: rgba(250, 250, 247, 0.88);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid var(--border-light);
    transition:
      background-color 0.4s var(--ease),
      border-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      backdrop-filter 0.4s var(--ease);
  }

  /* Pages with a hero (the homepage) let the photograph run to the very top:
     the bar is lifted out of the flow and stays transparent until scroll. */
  :global(body.has-hero) .site-header {
    position: fixed;
    inset-inline: 0;
  }

  /* Scoped to the resting state on purpose. Written as a plain
     `body.has-hero .site-header` it would outrank `.site-header.is-scrolled`
     on specificity and the bar would never turn solid. */
  :global(body.has-hero) .site-header:not(.is-scrolled):not(.is-menu-open) {
    background: transparent;
    border-block-end-color: transparent;
    backdrop-filter: none;
  }

  /* A whisper of a scrim keeps the forest-green nav legible over bright
     golden-hour photography without reading as a bar. */
  :global(body.has-hero) .site-header::before {
    content: '';
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 150px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(250, 250, 247, 0.8), rgba(250, 250, 247, 0));
    transition: opacity 0.4s var(--ease);
  }

  :global(body.has-hero) .site-header.is-scrolled::before {
    opacity: 0;
  }

  /* An open mobile menu needs the same solid treatment, whatever the
     scroll position — otherwise the panel hangs off a transparent bar. */
  .site-header.is-scrolled,
  .site-header.is-menu-open {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px) saturate(160%);
    border-block-end-color: var(--border-light);
    box-shadow: 0 6px 26px rgba(43, 38, 33, 0.1);
  }

  :global(body.has-hero) .site-header.is-menu-open::before {
    opacity: 0;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.75rem;
    min-block-size: var(--header-h);
  }

  /* ------------------------------- brand ------------------------------- */

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .brand__mark {
    inline-size: 48px;
    block-size: 48px;
    object-fit: contain;
  }

  .brand__text strong {
    display: block;
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--forest-green);
  }

  .brand__text > span {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--stone-gray);
    text-transform: uppercase;
  }

  /* Arabic has no uppercase, and the tracking hurts legibility */
  :global(:lang(ar)) .brand__text > span {
    text-transform: none;
  }

  /* ------------------------------- nav --------------------------------- */

  .main-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.4rem + 1.6vw, 2rem);
    list-style: none;
  }

  .main-nav a {
    position: relative;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--soil-dark);
    padding-block: 0.25rem;
    transition: color 0.2s var(--ease);
  }

  .main-nav a::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    inline-size: 0;
    block-size: 2px;
    background: var(--fresh-green);
    transition: inline-size 0.25s var(--ease);
  }

  .main-nav a:hover {
    color: var(--forest-green);
  }

  .main-nav a:hover::after {
    inline-size: 100%;
  }

  /* ----------------------------- actions -------------------------------- */

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    inline-size: 42px;
    block-size: 42px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
    background: var(--surface);
    color: var(--forest-green);
  }

  .nav-toggle__close {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__open {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__close {
    display: block;
  }

  /* --------------------------- mobile menu ------------------------------ */

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.25rem var(--gutter) 1.75rem;
    border-block-start: 1px solid var(--border-light);
    background: var(--warm-white);
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    list-style: none;
  }

  .mobile-nav a:not(.btn) {
    display: block;
    padding: 0.6875rem 0;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--soil-dark);
    border-block-end: 1px solid var(--border-light);
  }

  .mobile-nav .btn {
    align-self: flex-start;
  }

  /* --------------------------- breakpoints ------------------------------ */

  @media (max-width: 1080px) {
    .header-cta {
      display: none;
    }
  }

  @media (max-width: 940px) {
    .main-nav {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
    }
  }

  @media (max-width: 460px) {
    .brand__text > span {
      display: none;
    }

    .brand__mark {
      inline-size: 40px;
      block-size: 40px;
    }
  }

  /* At 375px the brand, the language pills and the menu button together
     overrun the container. Tighten the spacing rather than dropping the
     company name, which is the one thing that must survive. */
  @media (max-width: 520px) {
    .header-inner {
      gap: 0.625rem;
    }

    .brand {
      min-inline-size: 0;
    }

    .brand__text strong {
      font-size: 1rem;
      white-space: nowrap;
    }

    .nav-toggle {
      inline-size: 40px;
      block-size: 40px;
    }
  }

  @media (max-width: 360px) {
    .brand__text {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');

  if (toggle && menu) {
    const setMenu = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      toggle.setAttribute(
        'aria-label',
        (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? ''
      );
      header?.classList.toggle('is-menu-open', open);
    };

    toggle.addEventListener('click', () => {
      setMenu(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Close when a link is followed (same-page anchors would otherwise leave it open)
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setMenu(false);
    });

    // Reset the menu when the layout returns to desktop
    const desktop = window.matchMedia('(min-width: 941px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setMenu(false);
    });
  }

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
