---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatDate, localizePath, useTranslations, type Locale } from '../i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: Locale;
  loading?: 'eager' | 'lazy';
}

const { post, locale, loading = 'lazy' } = Astro.props;
const t = useTranslations(locale);
const { data } = post;

const href = localizePath(`/blog/${data.slug}`, locale);
---

<article class="blog-card card reveal">
  <a class="blog-card__link" href={href}>
    <div class="blog-card__media">
      <Image
        src={data.coverImage}
        alt={data.title[locale]}
        widths={[400, 640, 800]}
        sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 380px"
        loading={loading}
        class="blog-card__img"
      />
    </div>

    <div class="blog-card__body">
      <time class="blog-card__date" datetime={data.publishDate}>
        {formatDate(data.publishDate, locale)}
      </time>
      <h3>{data.title[locale]}</h3>
      <p class="blog-card__excerpt">{data.excerpt[locale]}</p>
      <span class="blog-card__more link-arrow">
        {t.actions.readMore}
        <Icon name="arrow-right" size={17} class="icon-arrow" />
      </span>
    </div>
  </a>
</article>

<style>
  .blog-card {
    overflow: hidden;
    block-size: 100%;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--sage-green);
  }

  .blog-card__link {
    display: flex;
    flex-direction: column;
    block-size: 100%;
  }

  .blog-card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-muted);
  }

  .blog-card__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .blog-card:hover .blog-card__img {
    transform: scale(1.05);
  }

  .blog-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.375rem 1.5rem;
  }

  .blog-card__date {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--harvest-gold);
    text-transform: uppercase;
  }

  .blog-card__body h3 {
    margin-block: 0.5rem 0.625rem;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .blog-card__excerpt {
    font-size: 0.9063rem;
    color: var(--stone-gray);
    line-height: 1.7;
    margin-block-end: 1rem;
  }

  .blog-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    margin-block-start: auto;
    font-size: 0.9063rem;
    font-weight: 700;
    color: var(--fresh-green);
  }

  .blog-card:hover .blog-card__more :global(.icon-arrow) {
    transform: translateX(3px);
  }

  :global([dir='rtl']) .blog-card:hover .blog-card__more :global(.icon-arrow) {
    transform: scaleX(-1) translateX(3px);
  }
</style>
