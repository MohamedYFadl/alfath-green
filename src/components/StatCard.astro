---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;

/**
 * Placeholder figures arrive as `[XX+]` / `[X,XXX]`. Until the client supplies
 * real numbers we render them dimmed so nobody mistakes them for data.
 */
const isPlaceholder = /^\[.*\]$/.test(value.trim());
---

<div class:list={['stat-card', { 'stat-card--placeholder': isPlaceholder }]}>
  <strong dir="ltr">{value}</strong>
  <span>{label}</span>
</div>

<style>
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.375rem 1rem;
    text-align: center;
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .stat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--sage-green);
  }

  .stat-card strong {
    display: block;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.875rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--forest-green);
    margin-block-end: 0.25rem;
  }

  .stat-card span {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--stone-gray);
  }

  .stat-card--placeholder strong {
    color: var(--sage-green);
    opacity: 0.75;
  }
</style>
