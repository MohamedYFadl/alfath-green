# =============================================================================
# Al Fath Green — environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
#
#   cp .env.example .env
#
# The PUBLIC_ prefix is required by Astro for values that must be readable in
# the browser. These three EmailJS values are designed to be public — the
# public key is domain-restricted in the EmailJS dashboard, which is what
# actually protects the account. Never put an EmailJS *private* key here.
# =============================================================================

# EmailJS service (dashboard → Email Services)
PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx

# EmailJS template (dashboard → Email Templates)
# The template must accept these variables, matching the contact form fields:
#   {{from_name}} {{from_email}} {{company}} {{country}} {{product}} {{message}}
PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# EmailJS public key (dashboard → Account → General → Public Key)
PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
